{
  "name": "dsh-notepad-card",
  "version": "4.0.0",
  "type": "module",
  "description": "Notepad for the Harness Web UI: a floating, edge-snapping card or a real bottom dock row, plus text and image notes, switchable at runtime.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "notepad",
    "notes",
    "dock"
  ],
  "author": "879745uhjun",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/879745uhjun/dsh-notepad.git"
  },
  "homepage": "https://github.com/879745uhjun/dsh-notepad#readme",
  "bugs": {
    "url": "https://github.com/879745uhjun/dsh-notepad/issues"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
